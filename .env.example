# ==============================================================================
# ITSM ENTERPRISE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Quick Setup for VPS Deployment:
# 1. cd laravel && cp .env.example .env
# 2. Update APP_URL, DB_* (Database credentials), and MAIL_* (SMTP details)
# 3. Run: php artisan key:generate
# 4. Run: php artisan migrate --force --seed
# 5. Run: php artisan storage:link
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="ITSM Enterprise"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://itsm.yourcompany.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. APPLICATION LOGGING
# ------------------------------------------------------------------------------
# In production VPS, 'daily' rotation prevents single log file from growing too large
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Production Standard: MySQL / MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itsm_enterprise
DB_USERNAME=itsm_db_user
DB_PASSWORD=your_secure_database_password_here

# Alternate: PostgreSQL (Uncomment if using PostgreSQL)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=itsm_enterprise
# DB_USERNAME=postgres
# DB_PASSWORD=your_password_here

# Alternate: SQLite (Testing/Development only)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/itsm/database/database.sqlite

# ------------------------------------------------------------------------------
# 4. SESSION, QUEUE & CACHE DRIVERS
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=itsm_cache_

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# 5. REDIS CONFIGURATION (Optional - for high-traffic environments)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 6. MAIL / SMTP EMAIL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Used for: Ticket Creation, Status Changes, Assignment Alerts, SLA Reminders
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-it-helpdesk@yourcompany.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="helpdesk@yourcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 7. TELEGRAM BOT NOTIFICATIONS (Optional Add-on)
# ------------------------------------------------------------------------------
# Get token from @BotFather, chat ID from @userinfobot or group chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 8. LDAP / ACTIVE DIRECTORY / ZIMBRA AUTHENTICATION (Optional Enterprise SSO)
# ------------------------------------------------------------------------------
LDAP_ENABLED=false
LDAP_HOST=127.0.0.1
LDAP_PORT=389
LDAP_BASE_DN="dc=yourcompany,dc=com"
LDAP_ADMIN_USER="cn=admin,dc=yourcompany,dc=com"
LDAP_ADMIN_PASSWORD=
LDAP_USE_SSL=false
LDAP_USE_TLS=false

# ------------------------------------------------------------------------------
# 9. AWS S3 / CLOUD OBJECT STORAGE (Optional for Ticket Attachments)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 10. FRONTEND VITE INTEGRATION
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
